# Copy to .env and fill in: cp .env.example .env

# Public URL of this app. The OAuth redirect URI is ${APP_URL}/oauth/callback
APP_URL=http://localhost:3000

# Random string of 32+ characters, e.g. `openssl rand -base64 32`.
# Encrypts stored tokens and signs cookies; changing it signs everyone out
# and makes stored tokens unreadable.
APP_SECRET=

# From the OAuth application registered on Backlog's developer site
BACKLOG_CLIENT_ID=
BACKLOG_CLIENT_SECRET=

# Optional: defaults to data/backlog-form.db
DATABASE_PATH=

# Optional: Cloudflare Turnstile is enabled only when both are set
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: defaults to 3000
PORT=3000
